# TeaQuest Environment Variables
# Copy this file to .env.local and fill in your values

# =========================================================
# FIREBASE CONFIGURATION
# Get these from: Firebase Console → Project Settings → General → Your apps
# =========================================================
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=1:123456789:web:abcdef123456

# =========================================================
# STRIPE CONFIGURATION (Optional - for real payments)
# Get these from: Stripe Dashboard → Developers → API keys
# =========================================================
# Publishable key (client-side)
TEAQUEST_STRIPE_KEY=pk_test_your_publishable_key

# Secret key (server-side only - for Firebase Functions)
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =========================================================
# OPTIONAL: ANALYTICS & MONITORING
# =========================================================
# Google Analytics
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (error tracking)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# =========================================================
# FEATURE FLAGS
# =========================================================
# Enable Minecraft Quest (heavy WebGL)
# ENABLE_MINECRAFT_QUEST=true

# Enable Tavern social features
# ENABLE_TAVERN=true

# Demo mode (no real payments)
# DEMO_MODE=true