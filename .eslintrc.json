{
  "env": {
    "browser": true,
    "es2022": true,
    "jest": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "globals": {
    "window": "readonly",
    "document": "readonly",
    "localStorage": "readonly",
    "console": "readonly",
    "fetch": "readonly",
    "crypto": "readonly",
    "performance": "readonly",
    "requestAnimationFrame": "readonly",
    "cancelAnimationFrame": "readonly",
    "MutationObserver": "readonly",
    "URL": "readonly",
    "File": "readonly",
    "FileReader": "readonly",
    "FormData": "readonly",
    "createImageBitmap": "readonly",
    "AudioContext": "readonly",
    "webkitAudioContext": "readonly",
    "PressStart2P": "readonly",
    "VT323": "readonly",
    "MC": "writable",
    "db": "writable",
    "currentUser": "writable",
    "products": "writable",
    "cart": "writable",
    "favorites": "writable",
    "orders": "writable",
    "customers": "writable",
    "activeCategory": "writable",
    "authMode": "writable",
    "toast": "writable",
    "showLevelUp": "writable",
    "openModal": "writable",
    "closeModal": "writable",
    "navigateTo": "writable",
    "showPage": "writable",
    "escapeHTML": "writable",
    "getLevelInfo": "writable",
    "discoverTea": "writable",
    "checkAchievements": "writable",
    "renderCodex": "writable",
    "saveCurrentUser": "writable",
    "syncProfile": "writable",
    "loadServerData": "writable",
    "restoreSession": "writable",
    "normalizeUser": "writable",
    "saveStorage": "writable",
    "getStorage": "writable",
    "sfx": "writable",
    "confettiBurst": "writable",
    "legendaryPulse": "writable",
    "pulseScreen": "writable",
    "openAuth": "writable",
    "renderEverything": "writable",
    "renderFeaturedProducts": "writable",
    "renderShopProducts": "writable",
    "renderCart": "writable",
    "renderFavorites": "writable",
    "updateNavigation": "writable",
    "renderProfile": "writable",
    "renderAdmin": "writable",
    "updateCounts": "writable",
    "initializeNavigation": "writable",
    "initializeTheme": "writable",
    "initializeShop": "writable",
    "initializeCart": "writable",
    "initializeFavorites": "writable",
    "initializeAuthentication": "writable",
    "initializeCheckout": "writable",
    "initializeContact": "writable",
    "initializeAdmin": "writable",
    "initializeRandomTea": "writable",
    "initializeRoulette": "writable",
    "initializeOracle": "writable",
    "initializeArcadePage": "writable",
    "initializePerfectBrew": "writable",
    "initializeLeafCatch": "writable",
    "initializeTeaMemory": "writable",
    "renderArcadeBests": "writable",
    "renderArcadeRecords": "writable",
    "openPerfectBrew": "writable",
    "openLeafCatch": "writable",
    "openTeaMemory": "writable",
    "recordArcadePlay": "writable",
    "saveArcadeScore": "writable",
    "awardArcadeXp": "writable",
    "refreshTavern": "writable",
    "shutdownTavern": "writable",
    "bootTavern": "writable",
    "loadDirectory": "writable",
    "refreshFriendState": "writable",
    "renderFriendLists": "writable",
    "renderSearchResults": "writable",
    "sendFriendRequest": "writable",
    "acceptRequest": "writable",
    "declineRequest": "writable",
    "removeBuddy": "writable",
    "openDm": "writable",
    "showFloor": "writable",
    "loadFloorHistory": "writable",
    "sendFloorMessage": "writable",
    "loadDmHistory": "writable",
    "sendDmLetter": "writable",
    "subscribeRealtime": "writable",
    "subscribePresence": "writable",
    "queueFriendshipSync": "writable"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-redeclare": ["error", { "builtinGlobals": false }],
    "no-undef": "off",
    "no-console": "off",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "multi-line"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "no-self-assign": "error",
    "no-useless-catch": "error",
    "no-unreachable": "error",
    "no-unreachable-loop": "error",
    "no-constant-binary-expression": "error",
    "no-constant-condition": "warn",
    "no-fallthrough": "error",
    "no-duplicate-case": "error",
    "default-case": "error",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-empty-pattern": "error",
    "no-extra-bind": "error",
    "no-extra-boolean-cast": "error",
    "no-extra-label": "error",
    "no-inner-declarations": "error",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "error",
    "no-obj-calls": "error",
    "no-prototype-builtins": "error",
    "no-regex-spaces": "error",
    "no-sparse-arrays": "error",
    "no-template-curly-in-string": "error",
    "no-unexpected-multiline": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "no-case-declarations": "error",
    "no-else-return": "warn",
    "no-empty-function": "warn",
    "no-lonely-if": "warn",
    "no-multi-assign": "warn",
    "no-multi-str": "warn",
    "no-new-wrappers": "warn",
    "no-octal": "warn",
    "no-return-assign": "warn",
    "no-self-compare": "warn",
    "no-sequences": "warn",
    "no-throw-literal": "warn",
    "no-unmodified-loop-condition": "warn",
    "no-unneeded-ternary": "warn",
    "no-unused-expressions": "warn",
    "no-useless-backreference": "warn",
    "no-useless-concat": "warn",
    "no-useless-escape": "warn",
    "no-void": "warn",
    "prefer-template": "warn",
    "object-shorthand": "warn",
    "prefer-arrow-callback": "warn",
    "prefer-destructuring": "warn",
    "prefer-numeric-literals": "warn",
    "prefer-rest-params": "warn",
    "prefer-spread": "warn",
    "require-await": "warn",
    "yoda": "warn"
  }
}